; Godot Web AI workspace sandbox.
; This project is the agent-side web workspace, never the user's Android editor.

config_version=5

[application]
config/name="Godot Web AI Workspace"
run/main_scene="res://scenes/main.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_command_center/plugin.cfg", "res://addons/godot_project_sync/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
